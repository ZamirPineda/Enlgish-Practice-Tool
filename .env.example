# Optional: key used by Vite build-time injection in vite.config.ts
GEMINI_API_KEY=replace_with_your_api_key

# Optional: enable frontend error reporting with Sentry (APP-403)
# Leave empty to keep Sentry disabled in local/dev setups
VITE_SENTRY_DSN=

# Optional: tracing sample rate for Sentry (0.0 - 1.0). Defaults to 0.2 in code.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Optional: only needed for scripts/import-study-docs.js
STUDIO_PATH=/absolute/path/to/source/docs
